# By default, force all HTML pages to revalidate freshness on every visit (prevent browser caching old index.html copies)
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Production assets are fingerprinted and immutable, cache aggressively for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Configuration and public metadata
/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate

# Graphic assets and branding
/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate
/og-image.png
  Cache-Control: public, max-age=86400, must-revalidate

# Sitemaps and Crawlers
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/plain; charset=utf-8
